# .driftfinder.yml — DriftFinder configuration
# Copy this file to .driftfinder.yml and edit for your environment.
# WARNING: .driftfinder.yml is gitignored. Never commit this file.

# Required: which IaC tool manages this infrastructure
iac_tool: terraform  # terraform | cloudformation | pulumi

# State source — set exactly one of these:
state_file: s3://my-company-tf-state/prod/terraform.tfstate  # Terraform
# stack_name: my-cloudformation-stack                        # CloudFormation / CDK
# pulumi_stack: my-org/my-project/prod                       # Pulumi

# AWS settings
aws_region: eu-west-1
# aws_profile: production  # Optional: uses default credential chain if omitted

# Scan behaviour
fail_on: CRITICAL          # CRITICAL | HIGH | MEDIUM | LOW
output_format: both        # json | html | both

# Scheduled scan output directory
schedule:
  output_dir: ./drift-reports

# Phase 2 — Slack notifications (not yet implemented)
# notify:
#   slack:
#     webhook: https://hooks.slack.com/services/xxx/yyy/zzz
#     on_severity: HIGH

# Phase 2 — AI fix suggestions (not yet implemented)
# ai:
#   provider: anthropic
#   # API key must be in ANTHROPIC_API_KEY environment variable
